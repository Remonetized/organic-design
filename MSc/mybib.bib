	keywords = {Computer Science - Networking and Internet Architecture, Condensed Matter - Statistical Mechanics, Physics - Physics and Society},
	pages = {75--86},
	file = {Full Text PDF:C\:\\Users\\jeeve\\Zotero\\storage\\NECGR8ZD\\Scholtes and Tessone - 2012 - Organic Design of Massively Distributed Systems A Complex Networks Perspective.pdf:application/pdf;Snapshot:C\:\\Users\\jeeve\\Zotero\\storage\\3JERNY3N\\1201.html:text/html},
